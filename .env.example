# Port the app listens on inside the container and the host port it is
# published on. Change to any free port (e.g. 8080) if 3000 is taken.
PORT=3000

# Public URL where the app will be reachable, e.g. https://hr.example.com
# Informational only in the demo build — set it to your real domain so the
# value is documented next to your deployment.
APP_URL=http://localhost:3000

# Node environment. Keep "production" for deployed instances.
NODE_ENV=production
